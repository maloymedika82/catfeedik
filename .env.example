# Do not commit .env. Real credentials belong only in secure environment settings.
# Injected environment values take precedence over the local developer file.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_IDS=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Open product decisions from the specification; no production defaults:
MAX_VIDEO_BYTES=
LOCATION_RADIUS_METERS=
MAX_GPS_ACCURACY_METERS=
# Production must use PostgreSQL, disable dev login, and provide HTTPS ingress.
# APP_ENV=production
# ALLOW_DEV_LOGIN=0
# DATABASE_URL=postgresql+psycopg://...
