# Do not commit .env. Real credentials belong only in secure environment settings.
# Injected environment values take precedence over the local developer file.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_IDS=2022054034
TELEGRAM_BOT_USERNAME=animalfeedikbot
# Local private storage on this machine. No Cloudflare/R2 account or keys needed.
# Relative paths are resolved from the project root. Do not put this under public/.
VIDEO_STORAGE_DIR=.local/videos
# Operational disk reserve: uploads stop before the disk fills (512 MiB).
VIDEO_MIN_FREE_BYTES=536870912
# In development, blank values use the user-approved test defaults:
# 20 MiB video, location radius 100 m, GPS accuracy 50 m.
# In production explicit approved values are required:
MAX_VIDEO_BYTES=
LOCATION_RADIUS_METERS=
MAX_GPS_ACCURACY_METERS=
# Production must use PostgreSQL, disable dev login, and provide HTTPS ingress.
# APP_ENV=production
# ALLOW_DEV_LOGIN=0
# DATABASE_URL=postgresql+psycopg://...

# AnyModel vision moderation. Rotate any key previously pasted into chat.
AI_BASE_URL=https://anymodel.org/v1
AI_API_KEY=
# auto selects a Gemini Flash ID actually returned by /models.
# An explicit provider model ID can be set if automatic discovery is unavailable.
AI_MODEL=auto
REDIS_URL=redis://127.0.0.1:6379/0
# Optional full executable paths on Windows if FFmpeg is not in PATH:
FFMPEG_BIN=
FFPROBE_BIN=
